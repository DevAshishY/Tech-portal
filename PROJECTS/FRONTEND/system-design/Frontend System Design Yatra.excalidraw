      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 10310.072155679938,
      "y": 1712.6149968510813,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 2414.510498046875,
      "height": 162.85714285714488,
      "seed": 2064686867,
