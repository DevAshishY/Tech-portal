      "fontSize": 39.01593717760169,
      "fontFamily": 5,
      "text": "The WebSocket API is an advanced technology that makes it possible to open a \ntwo-way interactive communication session between the user's browser and a server. ",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The WebSocket API is an advanced technology that makes it possible to open a \ntwo-way interactive communication session between the user's browser and a server. ",
      "autoResize": true,
      "lineHeight": 1.25
