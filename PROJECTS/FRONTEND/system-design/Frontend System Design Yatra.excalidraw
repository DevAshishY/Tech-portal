      "updated": 1726286907919,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 5,
      "text": "Short polling involves the client initiating \nrequests to the server at regular intervals\n(usually less than a minute)",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Short polling involves the client initiating requests to the server at regular intervals (usually less than a minute)",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "version": 284,
      "versionNonce": 576308126,
      "index": "b1kV",
      "isDeleted": false,
      "id": "fCgJo0KvrrbGitQe8Hyea",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": -323.92916146067455,
      "y": 4878.774004369926,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 763.7396240234375,
      "height": 180,
      "seed": 384931591,
      "groupIds": [
        "FsYX9Q9Gf3mFKxbUfGApn"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1726286907919,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 5,
      "text": "Long polling operates similarly to short \npolling, but the client stays connected and \nwaits for a response from the server until \nnew updates are available.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Long polling operates similarly to short polling, but the client stays connected and waits for a response from the server until new updates are available.",
      "autoResize": false,
      "lineHeight": 1.25
    },
